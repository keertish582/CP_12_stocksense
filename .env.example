# StockSense Environment Configuration
ENVIRONMENT=development
DEBUG=true

# Database (PostgreSQL in Docker Compose, fallback to SQLite locally)
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/stocksense_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=stocksense_db
POSTGRES_PORT=5432

# Redis & Celery
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# Security (Set a strong 32+ char secret in production)
JWT_SECRET_KEY=stocksense-super-secret-dev-key-change-in-production-2026
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Planning Parameters
DEFAULT_WAREHOUSE_CODE=WH-BLR-01
DEFAULT_WAREHOUSE_NAME=Central Distribution Hub - Bengaluru
DEFAULT_COVERAGE_DAYS=14
MIN_FORECAST_HORIZON_DAYS=30
DEFAULT_LEAD_TIME_DAYS=7
DEFAULT_SAFETY_STOCK=10

# Localization
DISPLAY_TIMEZONE=Asia/Kolkata
CURRENCY_CODE=INR
CURRENCY_SYMBOL=₹

# Frontend
VITE_API_BASE_URL=http://localhost:8000
